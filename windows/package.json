{
  "name": "control-electrico-windows",
  "version": "1.1.6",
  "description": "Control electrico local con respaldo opcional en Google Sheets",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Gerar",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build:web": "vite build",
    "build:msi": "pnpm run build:web && electron-builder --win msi --x64",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "jspdf": "^3.0.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.3.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.gerar.controlelectrico.windows",
    "productName": "Control Electrico",
    "artifactName": "ControlElectrico-Windows-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "warningsAsErrors": false,
      "additionalLightArgs": [
        "-sval"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Control Electrico",
      "runAfterFinish": true
    }
  },
  "packageManager": "pnpm@11.7.0"
}
